NEXT_PUBLIC_CLOUDINARY_CLOUD=your_cloudinary_cloud_id
NEXT_PUBLIC_CLOUDINARY_PRESET=your_cloudinary_upload_preset

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITEKEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Resend (order email)
# DELIVERABILITY: ORDER_FROM_EMAIL MUST be on your OWN domain, verified in the
# Resend dashboard (Domains -> Add domain -> add the DKIM/SPF/DMARC DNS records
# it gives you). Sending from onboarding@resend.dev or any unverified domain
# fails SPF/DKIM alignment -> lands in spam (and resend.dev only reaches your
# own address). Keep a friendly display name. A real, monitored reply address
# (or reply_to) is better than a no-reply.
RESEND_API_KEY=your_resend_api_key
ORDER_FROM_EMAIL=75Drawss <noreply@75drawss.com>
ORDER_TO_EMAIL=where-orders-should-arrive@example.com

# Ad pixels (optional). Leave empty to disable — nothing loads without an ID.
# Even with an ID, the pixels only load AFTER the visitor accepts cookies in the
# consent banner. Cookieless Vercel Analytics always runs regardless.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
